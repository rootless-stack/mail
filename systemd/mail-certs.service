[Unit]
Description=mail: load a renewed certificate into postfix and dovecot

# Both read ~/certs through their mount; a graceful reload makes them load
# the new files, without dropping a connection.  A container that is not
# running reads them at its next start.
[Service]
Type=oneshot
ExecStart=-/usr/bin/podman exec mail-postfix postfix reload
ExecStart=-/usr/bin/podman exec mail-dovecot doveadm reload
